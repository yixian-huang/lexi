{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi",
  "version": "0.3.0",
  "identifier": "com.yixian.lexi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lexi",
        "width": 1080,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.mymemory.translated.net https://github.com https://*.githubusercontent.com; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCNjZGQTYzRkM0NTU5MApSV1NRVmNRL3BtKzJCUnBuc1VjbkZvMStmK2FnN3Q3YUVGR0tycTJucVhlU0k1RkVYaEVSR001Ygo=",
      "endpoints": [
        "https://github.com/yixian-huang/lexi/releases/latest/download/latest.json"
      ]
    }
  }
}
